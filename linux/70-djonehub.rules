# DJOneHub on Linux: ModemManager keeps the QMI control port and the first AT
# interface (MI_02) for mobile data. DJOneHub takes the NMEA interface (MI_01),
# which Quectel Voice over USB streams call PCM on, and the second AT interface
# (MI_03). uaccess grants the logged-in desktop user access without dialout.
ACTION!="add|change", GOTO="djonehub_end"
SUBSYSTEM!="tty", GOTO="djonehub_end"
KERNEL!="ttyUSB[0-9]*", GOTO="djonehub_end"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="2c7c", ATTRS{idProduct}=="0125", GOTO="djonehub_match"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="2ca3", ATTRS{idProduct}=="4006", GOTO="djonehub_match"
GOTO="djonehub_end"

LABEL="djonehub_match"
ENV{ID_USB_INTERFACE_NUM}=="01|03", ENV{ID_MM_PORT_IGNORE}="1", TAG+="uaccess", SYMLINK+="djonehub-if$env{ID_USB_INTERFACE_NUM}"

LABEL="djonehub_end"
